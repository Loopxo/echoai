{
  "name": "echoai",
  "version": "2.3.4",
  "description": "EchoAI - open-source coding-agent CLI with sessions, tools, permissions, BYOK providers, and optional hosted credits",
  "main": "dist/index.js",
  "bin": {
    "echoai": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "packages/*/dist/**/*",
    "packages/*/package.json",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "bundleDependencies": [
    "@agentclientprotocol/sdk",
    "@alcalzone/ansi-tokenize",
    "@anthropic-ai/sdk",
    "@echoai/core",
    "@echoai/gateway",
    "@echoai/hooks",
    "@echoai/lsp",
    "@echoai/memory",
    "@echoai/runtime",
    "@echoai/skills",
    "@echoai/tui",
    "auto-bind",
    "axios",
    "bidi-js",
    "chalk",
    "cli-boxes",
    "code-excerpt",
    "commander",
    "cosmiconfig",
    "diff",
    "dotenv",
    "emoji-regex",
    "eventsource",
    "get-east-asian-width",
    "groq-sdk",
    "hono",
    "indent-string",
    "inquirer",
    "js-yaml",
    "lodash-es",
    "openai",
    "react",
    "react-reconciler",
    "semver",
    "signal-exit",
    "stack-utils",
    "strip-ansi",
    "supports-hyperlinks",
    "type-fest",
    "usehooks-ts",
    "uuid",
    "vscode-jsonrpc",
    "vscode-languageserver-protocol",
    "vscode-uri",
    "wrap-ansi",
    "ws",
    "zod"
  ],
  "workspaces": [
    "packages/*",
    "channels/*"
  ],
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm run build:packages && pnpm run build:app",
    "build:app": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "build:packages": "pnpm --recursive run build",
    "build:watch": "tsc --watch",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "test:packages": "pnpm --recursive --if-present run test",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "pnpm run build:packages && tsc --noEmit",
    "type-check:packages": "pnpm run build:packages",
    "validate": "pnpm run type-check && pnpm run test && pnpm run build:app && pnpm run smoke:cli",
    "smoke:cli": "node dist/cli.js --version",
    "type-check:watch": "tsc --noEmit --watch",
    "clean": "rm -rf dist coverage .nyc_output && pnpm --recursive run clean",
    "prepack": "npm run clean && npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "echo",
    "ai",
    "cli",
    "agents",
    "claude",
    "gpt",
    "groq",
    "meta",
    "llama",
    "developer-tools",
    "vscode",
    "automation",
    "optimization"
  ],
  "author": {
    "name": "Vijeet Shah",
    "email": "vijeet@vijeetshah.com",
    "url": "https://vijeetshah.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loopxo/echoai.git"
  },
  "bugs": {
    "url": "https://github.com/Loopxo/echoai/issues"
  },
  "homepage": "https://github.com/Loopxo/echoai#readme",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "@alcalzone/ansi-tokenize": "^0.1.3",
    "@anthropic-ai/sdk": "^0.24.0",
    "@echoai/core": "^1.0.0",
    "@echoai/gateway": "^1.0.0",
    "@echoai/hooks": "^1.0.0",
    "@echoai/lsp": "^1.0.0",
    "@echoai/memory": "^1.0.0",
    "@echoai/runtime": "^1.0.0",
    "@echoai/skills": "^1.0.0",
    "@echoai/tui": "^1.0.0",
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/ws": "^8.18.1",
    "auto-bind": "^5.0.1",
    "axios": "^1.6.0",
    "bidi-js": "^1.0.3",
    "chalk": "^5.3.0",
    "cli-boxes": "^3.0.0",
    "code-excerpt": "^4.0.0",
    "commander": "^11.1.0",
    "cosmiconfig": "^9.0.0",
    "diff": "^8.0.2",
    "dotenv": "^16.3.0",
    "emoji-regex": "^10.3.0",
    "eventsource": "^4.0.0",
    "get-east-asian-width": "^1.2.0",
    "groq-sdk": "^0.7.0",
    "hono": "^4.0.0",
    "indent-string": "^5.0.0",
    "inquirer": "^9.2.0",
    "js-yaml": "^4.1.0",
    "lodash-es": "^4.17.21",
    "openai": "^4.20.0",
    "react": "^19.1.0",
    "react-reconciler": "^0.32.0",
    "semver": "^7.6.3",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.1.0",
    "supports-hyperlinks": "^3.0.0",
    "type-fest": "^4.26.1",
    "usehooks-ts": "^3.1.0",
    "uuid": "^12.0.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-uri": "^3.1.0",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.8.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.2.0",
    "vitest": "^1.0.0"
  }
}
