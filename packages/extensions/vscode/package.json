{
  "name": "echoai-vscode",
  "displayName": "EchoAI",
  "description": "EchoAI coding-agent workflows from VS Code.",
  "version": "1.2.1",
  "publisher": "LoopXo",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Snippets",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "artificial intelligence",
    "code completion",
    "agents",
    "specialized agents",
    "quantum code",
    "predictive",
    "intellisense",
    "assistant",
    "typescript",
    "javascript",
    "python",
    "java",
    "security",
    "refactoring",
    "multi-provider",
    "claude",
    "openai",
    "copilot alternative",
    "echo",
    "development studio"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/clean-extension.js",
  "contributes": {
    "icons": {
      "echoai-icon": {
        "description": "EchoAI logo",
        "default": {
          "fontPath": "./icon.png"
        }
      }
    },
    "commands": [
      {
        "command": "echoai.explain",
        "title": "Explain Code"
      },
      {
        "command": "echoai.refactor",
        "title": "Refactor Code"
      },
      {
        "command": "echoai.generateTests",
        "title": "Generate Tests"
      },
      {
        "command": "echoai.configure",
        "title": "Configure EchoAI"
      },
      {
        "command": "echoai.showCLI",
        "title": "Open EchoAI Terminal",
        "icon": "$(echoai-icon)"
      },
      {
        "command": "echoai.performance",
        "title": "Show Performance"
      },
      {
        "command": "echoai.memory",
        "title": "EchoAI: Memory Context"
      },
      {
        "command": "echoai.sessions",
        "title": "EchoAI: Sessions"
      },
      {
        "command": "echoai.docs",
        "title": "EchoAI: Generate Documentation"
      },
      {
        "command": "echoai.skills",
        "title": "EchoAI: Skills"
      },
      {
        "command": "echoai.gateway",
        "title": "EchoAI: Gateway Status"
      }
    ],
    "keybindings": [
      {
        "command": "echoai.explain",
        "key": "ctrl+shift+e",
        "when": "editorHasSelection"
      },
      {
        "command": "echoai.showCLI",
        "key": "ctrl+shift+c",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "EchoAI",
      "properties": {
        "echoAI.provider": {
          "type": "string",
          "default": "claude",
          "enum": [
            "claude",
            "openai",
            "groq",
            "openrouter",
            "meta"
          ],
          "description": "AI provider for completions"
        },
        "echoAI.model": {
          "type": "string",
          "default": "claude-3-5-sonnet-20241022",
          "description": "Model to use for completions"
        },
        "echoAI.enableInlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline completions"
        },
        "echoAI.completionDelay": {
          "type": "number",
          "default": 1000,
          "description": "Delay before showing completions (ms)"
        },
        "echoAI.maxContextSize": {
          "type": "number",
          "default": 2000,
          "description": "Maximum context size for AI requests"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "echoai.showCLI",
          "group": "navigation@1",
          "when": "resourceExtname =~ /\\.(js|ts|jsx|tsx|py|java|cpp|c|cs|php|rb|go|rs|swift|kt|dart|scala|clj|hs|ml|fs|pas|pl|r|jl|nim|zig|v)$/"
        }
      ],
      "editor/title/run": [
        {
          "command": "echoai.showCLI",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "echoai.explain",
          "when": "editorHasSelection",
          "group": "EchoAI"
        },
        {
          "command": "echoai.refactor",
          "when": "editorHasSelection",
          "group": "EchoAI"
        },
        {
          "command": "echoai.generateTests",
          "when": "editorTextFocus",
          "group": "EchoAI"
        },
        {
          "command": "echoai.showCLI",
          "when": "editorTextFocus",
          "group": "EchoAI"
        }
      ],
      "view/title": [
        {
          "command": "echoai.showCLI",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "echoai.showCLI",
          "when": "true"
        },
        {
          "command": "echoai.explain",
          "when": "editorHasSelection"
        },
        {
          "command": "echoai.refactor",
          "when": "editorHasSelection"
        },
        {
          "command": "echoai.generateTests",
          "when": "true"
        },
        {
          "command": "echoai.configure",
          "when": "true"
        },
        {
          "command": "echoai.performance",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'Skipping compile for packaging'",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.102.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/vijeet-shah/echoai.git",
    "directory": "extensions/vscode"
  },
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#A8E6CF",
    "theme": "light"
  }
}
