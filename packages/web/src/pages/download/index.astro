---
import EchoMarketingShell from "../../components/app/EchoMarketingShell.astro";
---

<EchoMarketingShell
  title="Download EchoAI"
  eyebrow="Install surfaces"
  description="Start with the CLI today, then connect the private web app, desktop cowork app, and mobile control surface as the ecosystem matures."
>
  <section class="echo-grid">
    <article class="echo-card span-4"><h2>CLI</h2><pre class="echo-code">npm install -g echoai
echoai init
echoai chat</pre></article>
    <article class="echo-card span-4"><h2>Desktop</h2><p>Electron Windows/macOS app for local workspace control, terminal tasks, browser automation, and approvals.</p></article>
    <article class="echo-card span-4"><h2>Mobile</h2><p>iOS and Android apps for chat, capture, desktop approvals, and run notifications.</p></article>
  </section>
</EchoMarketingShell>

