---
import EchoAppShell from "../../../components/app/EchoAppShell.astro";
---

<EchoAppShell
  title="Outputs"
  eyebrow="Artifacts and generated work"
  active="outputs"
  description="Outputs collect generated reports, documents, images, code artifacts, automation results, and desktop-created files with metadata and download controls."
>
  <section class="echo-grid">
    <article class="echo-card span-3"><h2>Reports</h2><p>HTML, PDF, markdown, and DOCX results from research or code tasks.</p></article>
    <article class="echo-card span-3"><h2>Code</h2><p>Patch sets, generated files, diffs, and review summaries.</p></article>
    <article class="echo-card span-3"><h2>Media</h2><p>Images, videos, audio transcriptions, and multimodal generations.</p></article>
    <article class="echo-card span-3"><h2>Automation runs</h2><p>Recurring job outputs with schedule, cost, context, and audit trace.</p></article>
  </section>
</EchoAppShell>

