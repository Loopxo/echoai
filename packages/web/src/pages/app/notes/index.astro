---
import EchoAppShell from "../../../components/app/EchoAppShell.astro";
import { notes } from "../../../lib/echoai-app-data";
---

<EchoAppShell
  title="Notes"
  eyebrow="Notebook context"
  active="notes"
  description="Notes give users a durable writing surface that can be mentioned in chat, linked to projects, exported, and searched."
>
  <section class="echo-grid">
    <article class="echo-card span-7">
      <div class="echo-card-header">
        <h2>Notebook editor contract</h2>
        <span class="echo-tag good">W-076..W-079</span>
      </div>
      <pre class="echo-code">rich note -> project link -> searchable content
  -> @mention in chat -> model context builder
  -> export to markdown, PDF, DOCX</pre>
    </article>
    <article class="echo-card span-5">
      <h2>Recent notes</h2>
      <ul class="echo-list" style="margin-top: 12px;">
        {notes.map((note) => (
          <li class="echo-list-item">
            <strong>{note.title}</strong>
            <span>{note.project} - {note.updated}</span>
            <span>{note.use}</span>
          </li>
        ))}
      </ul>
    </article>
  </section>
</EchoAppShell>

