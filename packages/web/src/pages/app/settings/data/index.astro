---
import EchoAppShell from "../../../../components/app/EchoAppShell.astro";
---

<EchoAppShell title="Data Settings" eyebrow="Export and deletion" active="settings" description="Data settings manage retention, export, hard delete, memory privacy, file storage, and cloud sync choices.">
  <section class="echo-grid">
    <article class="echo-card span-3"><h2>Export</h2><p>Sessions, files, notes, memories, outputs, and audit summaries.</p></article>
    <article class="echo-card span-3"><h2>Delete</h2><p>Hard delete user/workspace records, storage objects, chunks, and embeddings.</p></article>
    <article class="echo-card span-3"><h2>Retention</h2><p>Set workspace retention windows by artifact and event type.</p></article>
    <article class="echo-card span-3"><h2>Sync</h2><p>Control what desktop, mobile, CLI, and cloud are allowed to exchange.</p></article>
  </section>
</EchoAppShell>

