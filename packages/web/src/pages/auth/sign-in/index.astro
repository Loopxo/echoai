---
import EchoAuthShell from "../../../components/app/EchoAuthShell.astro";
---

<EchoAuthShell
  title="Sign in"
  description="Enter the private EchoAI web workspace. Hosted models, billing, BYOK vault, and device sync will be attached here."
>
  <section class="echo-grid">
    <article class="echo-card span-7">
      <div class="echo-card-header">
        <h2>Email sign in</h2>
        <span class="echo-tag warn">Backend required</span>
      </div>
      <div class="echo-list">
        <label class="echo-list-item">
          <strong>Email</strong>
          <span>user@example.com</span>
        </label>
        <label class="echo-list-item">
          <strong>Password or magic link</strong>
          <span>Authentication provider wiring comes from private EchoAI Cloud.</span>
        </label>
      </div>
      <div class="echo-actions" style="margin-top: 14px;">
        <a class="echo-button" href="/app">Continue to app shell</a>
        <a class="echo-button-secondary" href="/auth/forgot-password">Forgot password</a>
      </div>
    </article>

    <aside class="echo-card span-5">
      <h2>Supported sign-in targets</h2>
      <ul class="echo-list" style="margin-top: 12px;">
        <li class="echo-list-item"><strong>Web</strong><span>Browser session cookie and CSRF protection.</span></li>
        <li class="echo-list-item"><strong>Desktop</strong><span>Device-code or `echoai://` callback into Electron/native clients.</span></li>
        <li class="echo-list-item"><strong>Mobile</strong><span>Deep link completion through `/auth/mobile-complete`.</span></li>
      </ul>
    </aside>
  </section>
</EchoAuthShell>

