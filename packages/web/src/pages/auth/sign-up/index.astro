---
import EchoAuthShell from "../../../components/app/EchoAuthShell.astro";
---

<EchoAuthShell
  title="Create workspace"
  description="Create an EchoAI account and first private workspace for web, desktop, mobile, and CLI continuity."
>
  <section class="echo-card">
    <div class="echo-card-header">
      <h2>Workspace bootstrap</h2>
      <span class="echo-tag good">W-012</span>
    </div>
    <table class="echo-table">
      <tbody>
        <tr><th>Identity</th><td>Email, SSO, or social provider.</td></tr>
        <tr><th>Workspace</th><td>Default personal workspace with one owner role.</td></tr>
        <tr><th>Defaults</th><td>Free model lane, hosted upgrade path, memory disabled until confirmed.</td></tr>
        <tr><th>Next step</th><td>Choose model lane, pair desktop, or start first chat.</td></tr>
      </tbody>
    </table>
  </section>
</EchoAuthShell>

