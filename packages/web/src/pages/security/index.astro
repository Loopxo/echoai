---
import EchoMarketingShell from "../../components/app/EchoMarketingShell.astro";
---

<EchoMarketingShell title="Security" eyebrow="Trust model" description="EchoAI security spans hosted auth, provider vaults, runtime permission policy, tool audit logs, device trust, and sandboxed local execution.">
  <section class="echo-grid">
    <article class="echo-card span-4"><h2>Permissions</h2><p>Write, process, network, MCP, browser, and desktop actions run through allow/ask/deny policy.</p></article>
    <article class="echo-card span-4"><h2>Vault</h2><p>BYOK provider keys require encryption, redaction, role scopes, rotation, and access audit.</p></article>
    <article class="echo-card span-4"><h2>Devices</h2><p>Desktop and mobile pairing needs revocable trust, TLS pinning, and explicit approval events.</p></article>
  </section>
</EchoMarketingShell>

