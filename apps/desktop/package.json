{
  "name": "@echoai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EchoAI private Windows and macOS desktop app",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "package": "pnpm run build && electron-builder --config electron-builder.yml --dir",
    "dist": "pnpm run build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@echoai/runtime": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^1.6.1"
  }
}
