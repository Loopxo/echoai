# EchoAI CLI Environment Variables
# Copy this file to .env and fill in your API keys

# Optional EchoAI Cloud API key. Prefer `echoai login` for normal hosted usage.
ECHOAI_API_KEY=echoai-your-api-key-here

# DeepSeek local BYOK.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Kimi / Moonshot local BYOK.
MOONSHOT_API_KEY=your-moonshot-api-key-here
KIMI_API_KEY=your-kimi-api-key-here

# Zhipu AI / GLM local BYOK.
ZHIPU_API_KEY=your-zhipu-api-key-here

# Qwen / Alibaba DashScope local BYOK.
QWEN_API_KEY=your-dashscope-api-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# MiniMax local BYOK.
MINIMAX_API_KEY=your-minimax-api-key-here

# Default Provider (echoai, deepseek, kimi, zhipu, qwen, minimax, nim)
ECHO_DEFAULT_PROVIDER=echoai

# Default Model / preset
ECHO_DEFAULT_MODEL=code

# Default Temperature (0-2)
ECHO_DEFAULT_TEMPERATURE=0.7

# Default Max Tokens
ECHO_DEFAULT_MAX_TOKENS=4096

# Enable streaming by default (true/false)
ECHO_DEFAULT_STREAMING=true

# Enable VS Code integration (true/false)
ECHO_VSCODE_ENABLED=true

# Enable diff preview (true/false)
ECHO_DIFF_PREVIEW=true

# Debug mode (true/false)
DEBUG=false
